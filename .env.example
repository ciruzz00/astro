# Copy to .env (never commit it) or set the same keys in config.toml.
# Every key is optional: sources without a key are skipped or rate limited.

# https://www.virustotal.com/gui/my-apikey
ASTRO_VIRUSTOTAL_KEY=
# https://auth.abuse.ch/ (MalwareBazaar, ThreatFox, URLhaus)
ASTRO_ABUSECH_KEY=
# https://www.abuseipdb.com/account/api
ASTRO_ABUSEIPDB_KEY=
# https://otx.alienvault.com/settings
ASTRO_OTX_KEY=
# https://account.shodan.io/
ASTRO_SHODAN_KEY=
# https://viz.greynoise.io/account/api-key
ASTRO_GREYNOISE_KEY=
# https://nvd.nist.gov/developers/request-an-api-key (raises the NVD rate limit)
ASTRO_NVD_KEY=
