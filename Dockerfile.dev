# Development image: Go toolchain plus pinned static analysis tools.
FROM golang:1.27-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195

ARG UID=1000
ARG GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends zip \
    && rm -rf /var/lib/apt/lists/*

RUN GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@v1.8.0 \
    && GOBIN=/usr/local/bin go install honnef.co/go/tools/cmd/staticcheck@v0.8.1 \
    && GOBIN=/usr/local/bin go install github.com/securego/gosec/v2/cmd/gosec@v2.29.0 \
    && rm -rf /root/go /root/.cache

RUN groupadd -o -g "${GID}" dev \
    && useradd -o -m -u "${UID}" -g "${GID}" dev \
    && mkdir -p /home/dev/go/pkg/mod /home/dev/.cache/go-build /data \
    && chown -R dev:dev /home/dev /data

USER dev
ENV GOPATH=/home/dev/go \
    GOMODCACHE=/home/dev/go/pkg/mod \
    GOCACHE=/home/dev/.cache/go-build \
    GOFLAGS="-mod=readonly -buildvcs=false" \
    GOTOOLCHAIN=local \
    ASTRO_DATA_DIR=/data

WORKDIR /src
